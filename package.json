{
  "name": "balast",
  "version": "0.1.0",
  "private": true,
  "description": "Balast \u2014 liquidity layer for Robinhood Chain. P0: shell and simulated data.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "api": "tsx server/api/main.ts",
    "indexer": "tsx server/indexer/main.ts",
    "doctor": "bash deploy/doctor.sh",
    "verify:chain": "tsx server/scripts/verify-chain.ts",
    "find:tokens": "tsx server/scripts/find-tokens.ts",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "brand": "python3 scripts/build-brand.py && node scripts/build-brand-png.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.0",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.4",
    "ioredis": "^6.0.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "^2.56.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "20.14.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "prisma": "^6.19.3",
    "tsx": "^4.23.13",
    "typescript": "5.6.3",
    "vitest": "^2.1.8"
  }
}
