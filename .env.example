# ---------------------------------------------------------------- frontend --

# Which DataProvider the app reads from (§4).
#   sim   — the P0 simulator: the prototype's generated pools, vaults and positions
#   live  — the P1 indexer, through the API below
DATA_SOURCE=sim

# Where the browser reaches the API. Empty means same origin, which is what
# nginx serves in production; set it only for `next dev` against a remote API.
# NEXT_PUBLIC_API_BASE=

# ------------------------------------------------------------------- P1 db --

DATABASE_URL="postgresql://balast:CHANGEME@127.0.0.1:5432/balast?schema=public"

# Optional. Without it the indexer→API tick bus is in-process, which is correct
# for one API instance on one box and silently wrong for two.
# REDIS_URL="redis://127.0.0.1:6379"

# ---------------------------------------------------------------- P1 chain --

# Robinhood Chain, chainId 4663 (§2). Tried in order; the first that answers
# is used and kept until it fails. These are the public endpoints from the
# chain registry — put a paid one first if you have it.
RPC_URLS="https://rpc.mainnet.chain.robinhood.com,https://robinhood-rpc.publicnode.com,https://rpc.arrowrpc.com,https://rpc.ordofi.network"

# THE ONE THING THE INDEXER CANNOT START WITHOUT.
# USDG is the day-one stablecoin on this chain, not USDC (§2), and the
# WETH/USDG pool is the site's single USD anchor (§4.3). Find it on the
# explorer (hoodscan.co or the Blockscout instance) and set it here. With it
# unset the indexer refuses to start, rather than running and reporting every
# USD figure as zero.
USDG_ADDRESS=

# Block to start from. Leaving it at 0 scans the chain from genesis, which on
# ~100ms blocks (§2) is a very long first sync. Set it to the PoolManager's
# deployment block.
START_BLOCK=0

# Blocks per eth_getLogs call. Most public endpoints cap this well below 10k.
INDEXER_BLOCK_RANGE=2000
# Milliseconds between passes once caught up to head.
INDEXER_POLL_MS=1000

# Launchpad hook addresses (§4). A pool whose hook is one of these is
# pre-graduation: listed, but never offered as a stake. Empty means every pool
# is treated as stakeable — fine for a listing, WRONG for a vault, so P2 must
# not deploy against pools discovered while this was blank.
#   LAUNCHPAD_HOOKS="Pons:0x…,Bags:0x…,Bottom.fun:0x…"
LAUNCHPAD_HOOKS=

# v3 pools to follow. v3 has one contract per pool, so these are listed
# explicitly; v4 needs only the PoolManager.
#   V3_POOLS="0x…,0x…"
V3_POOLS=

# ------------------------------------------------------------------ P1 api --

API_PORT=3001
API_HOST=127.0.0.1
# §4.4: push on real events, debounced to about a second per pool.
STREAM_DEBOUNCE_MS=1000

# ----------------------------------------------------------------- testing --

# The §9 acceptance test truncates this database on every run, so the name
# must contain "balast_test" or the suite refuses to start.
# TEST_DATABASE_URL="postgresql://postgres@127.0.0.1:5433/balast_test?schema=public"
