// Balast P1 — the indexer's database (§4).
//
// The schema sketch in §4 is followed field for field. Two things are added,
// and both exist to make §9's acceptance criterion reachable rather than
// aspirational:
//
//   swap_events / liquidity_events — the raw log rows, keyed (tx_hash,
//   log_index). §4 says "writes raw rows" and "upsert by (txHash, logIndex)";
//   these are those rows.
//
//   pool_fee_hourly is DERIVED from them by aggregation, never incremented.
//   That is the whole trick behind §9: an increment is order-dependent and a
//   replay double-counts, but re-aggregating a set of rows keyed by
//   (tx_hash, log_index) gives byte-identical output no matter how many times
//   the same logs arrive, in what order, or in what range sizes.
//
// Money is Decimal, never Float. A USD figure that drifts by a rounding error
// every pass would make §9 unprovable and the displayed numbers untrustworthy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- discovery --

model Token {
  address      String    @id
  symbol       String
  name         String
  decimals     Int       @default(18)
  /// `totalSupply()`, read from the token contract.
  ///
  /// This is TOTAL supply, not circulating: locked, vested and treasury-held
  /// tokens are all in it, and none of that is distinguishable on chain. So
  /// the figure it produces is fully diluted value, and it is labelled as
  /// such rather than called market cap (§7). Null until it has been read.
  totalSupply  Decimal?  @map("total_supply") @db.Decimal(78, 0)
  /// When the supply was last read. Mintable tokens change, so it is
  /// refreshed on a cadence rather than once at discovery.
  supplyReadAt DateTime? @map("supply_read_at")
  /// Tokens that cannot circulate, read alongside the supply: the balances
  /// of the burn addresses (0x0, 0xdEaD) and of the token contract itself.
  /// Total supply less this is the circulating figure the market cap is
  /// built from. Vesting and treasury holdings are not distinguishable on
  /// chain, so that figure can still overstate, never understate. Null
  /// until read.
  nonCirculating Decimal? @map("non_circulating") @db.Decimal(78, 0)
  logoUrl      String?   @map("logo_url")
  /// When the external logo sources were last asked about this token. Null
  /// means never; set even when nothing was found, so a token nobody lists
  /// is not asked about on every pass against rate-limited public APIs.
  logoCheckedAt DateTime? @map("logo_checked_at")
  /// Brand colour. Metadata, not a design decision (§5).
  logoColor    String?   @map("logo_color")
  /// Pons, Bags, Bottom.fun — set when the token came from a launchpad (§4).
  launchpad    String?
  firstSeen    DateTime  @map("first_seen")

  poolsAsToken0 Pool[] @relation("token0")
  poolsAsToken1 Pool[] @relation("token1")

  @@index([symbol])
  @@map("tokens")
}

model Pool {
  id            String   @id
  address       String
  chainId       Int      @map("chain_id")
  token0        String
  token1        String
  feeTier       Int      @map("fee_tier")
  tickSpacing   Int      @map("tick_spacing")
  hooks         String?
  /// "v4" or "v3" — some older pools on this chain are v3 (§4).
  protocol      String
  createdBlock  BigInt   @map("created_block")
  /// The price and tick the pool was initialised at.
  ///
  /// An immutable fact from the Initialize log, and the only price a pool has
  /// before its first swap. Without it stored, a ModifyLiquidity arriving in
  /// a later batch for a pool that has not traded yet cannot be valued — and
  /// the ingest step could only throw, which halted the indexer completely.
  initSqrtPrice Decimal? @map("init_sqrt_price_x96") @db.Decimal(78, 0)
  initTick      Int?     @map("init_tick")
  /// Set from the block timestamp of Initialize, so pool age is chain time.
  createdAt     DateTime @map("created_at")
  /// Pre-graduation launchpad liquidity is listed but NOT stakeable (§4).
  stakeable     Boolean  @default(true)

  tokenA Token @relation("token0", fields: [token0], references: [address])
  tokenB Token @relation("token1", fields: [token1], references: [address])

  swaps            SwapEvent[]
  liquidity        LiquidityEvent[]
  feeHours         PoolFeeHourly[]
  state            PoolState?
  vault            Vault?
  positions        Position[]
  poolFlowHourlies PoolFlowHourly[]

  @@unique([address, chainId])
  @@index([protocol])
  @@map("pools")
}

// -------------------------------------------------------------- raw events --
// Upserted by (tx_hash, log_index). Re-scanning the last 32 blocks every pass
// (§4.1) therefore costs nothing and changes nothing.

/// The last day of swaps, from the chain's head, while the backfill is still
/// weeks behind it (§25). Deliberately outside the indexer's pipeline: a
/// window of recent blocks with a gap behind it cannot contribute to reserves
/// or to §9's replay proof, so these rows feed the day's volume, its trade
/// split and the 24h move, and nothing else. No relation to Pool: the head
/// meets pools the backfill has not created yet.
model RecentSwap {
  txHash    String   @map("tx_hash")
  logIndex  Int      @map("log_index")
  poolId    String   @map("pool_id")
  blockNum  BigInt   @map("block_num")
  blockTime DateTime @map("block_time")
  amount0   Decimal  @db.Decimal(78, 0)
  amount1   Decimal  @db.Decimal(78, 0)
  sqrtPrice Decimal  @map("sqrt_price_x96") @db.Decimal(78, 0)
  feeAmount Decimal  @map("fee_amount") @db.Decimal(78, 0)
  feeToken  Int      @map("fee_token")

  @@id([txHash, logIndex])
  @@index([blockTime])
  @@index([poolId, blockTime])
  @@map("recent_swaps")
}

model SwapEvent {
  txHash    String   @map("tx_hash")
  logIndex  Int      @map("log_index")
  poolId    String   @map("pool_id")
  blockNum  BigInt   @map("block_num")
  blockTime DateTime @map("block_time")
  /// Signed, in token units as emitted. amount0 < 0 means token0 left the pool.
  amount0   Decimal  @db.Decimal(78, 0)
  amount1   Decimal  @db.Decimal(78, 0)
  sqrtPrice Decimal  @map("sqrt_price_x96") @db.Decimal(78, 0)
  liquidity Decimal  @db.Decimal(78, 0)
  tick      Int
  /// Fee charged on this swap, in the input token's smallest unit.
  feeAmount Decimal  @map("fee_amount") @db.Decimal(78, 0)
  /// Which side the fee was taken in: 0 or 1.
  feeToken  Int      @map("fee_token")
  sender    String

  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@id([txHash, logIndex])
  @@index([poolId, blockTime])
  @@index([blockNum])
  /// For "the pool's latest state": a DISTINCT ON (pool_id) ordered by
  /// position. Without it that query is a sort of the whole table on every
  /// pass, which is the difference between a second and a minute once the
  /// chain has a few million swaps in it.
  @@index([poolId, blockNum, logIndex])
  @@map("swap_events")
}

model LiquidityEvent {
  txHash         String   @map("tx_hash")
  logIndex       Int      @map("log_index")
  poolId         String   @map("pool_id")
  blockNum       BigInt   @map("block_num")
  blockTime      DateTime @map("block_time")
  tickLower      Int      @map("tick_lower")
  tickUpper      Int      @map("tick_upper")
  /// Signed: negative is a burn. v3 Mint/Burn are normalised to this.
  liquidityDelta Decimal  @map("liquidity_delta") @db.Decimal(78, 0)
  amount0        Decimal  @db.Decimal(78, 0)
  amount1        Decimal  @db.Decimal(78, 0)
  owner          String
  /// v4's position salt. For a position minted through PositionManager it
  /// is bytes32(tokenId), which ties the position to its own liquidity
  /// events (§22). Null for v3, and for v4 rows written before the column.
  salt           String?

  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@id([txHash, logIndex])
  @@index([poolId, blockTime])
  @@index([blockNum])
  @@index([salt])
  @@map("liquidity_events")
}

/// PositionManager's ERC-721 Transfer logs: who holds which position token.
/// Raw and keyed by log coordinates, like the swap rows; `positions` is
/// rebuilt from these and the salted liquidity events (§22).
model PositionTransfer {
  txHash    String   @map("tx_hash")
  logIndex  Int      @map("log_index")
  tokenId   Decimal  @map("token_id") @db.Decimal(78, 0)
  /// bytes32(tokenId), lowercase: the salt the position's liquidity events carry.
  salt      String
  fromAddr  String   @map("from_addr")
  toAddr    String   @map("to_addr")
  blockNum  BigInt   @map("block_num")
  blockTime DateTime @map("block_time")

  @@id([txHash, logIndex])
  @@index([salt, blockNum, logIndex])
  @@index([toAddr])
  @@index([blockNum])
  @@map("position_transfers")
}

/// One row per contract the poller follows, so a restart resumes rather than
/// rescanning the chain.
model IndexerCursor {
  contract         String   @id
  lastIndexedBlock BigInt   @map("last_indexed_block")
  /// Block time of that block: the honest input to the lag shown in the top bar (§7).
  lastIndexedAt    DateTime @map("last_indexed_at")
  /// The chain's head at that pass, so how far through a first sync it is can be
  /// reported without the API having to ask a node. Null before the first pass.
  headBlock        BigInt?  @map("head_block")
  updatedAt        DateTime @map("updated_at")

  @@map("indexer_cursors")
}

/// Small facts the indexer has to remember across restarts, by name.
/// `rebuilt_anchor`: the USD anchor the priced tables were last fully rebuilt
/// for, so a restart with the same anchor does not redo hours of work.
model IndexerState {
  key       String   @id
  value     String
  updatedAt DateTime @map("updated_at")

  @@map("indexer_state")
}

// ------------------------------------------------------------- aggregations --

/// Derived from swap_events by aggregation. Never incremented — see the header.
model PoolFeeHourly {
  poolId     String   @map("pool_id")
  /// Truncated to the hour, UTC.
  hour       DateTime
  feesToken0 Decimal  @map("fees_token0") @db.Decimal(78, 0)
  feesToken1 Decimal  @map("fees_token1") @db.Decimal(78, 0)
  feesUsd    Decimal  @map("fees_usd") @db.Decimal(38, 18)
  volumeUsd  Decimal  @map("volume_usd") @db.Decimal(38, 18)
  swaps      Int
  /// The split a trader reads: a swap paying the quote for the token is a
  /// buy, the reverse a sell. Derived from the swap rows' input side.
  buys          Int     @default(0)
  sells         Int     @default(0)
  buyVolumeUsd  Decimal @default(0) @map("buy_volume_usd") @db.Decimal(38, 18)
  sellVolumeUsd Decimal @default(0) @map("sell_volume_usd") @db.Decimal(38, 18)

  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@id([poolId, hour])
  @@index([hour])
  @@map("pool_fee_hourly")
}

/**
 * Signed token flow per pool per hour, derived from swap and liquidity events.
 * A pool's reserves are the sum of every signed amount it ever emitted — on v4
 * that is the only way to get them, since the PoolManager holds every pool's
 * tokens in one balance. Summing the raw event tables directly is correct and
 * completely unscalable: it is a full scan of both tables, for every pool, on
 * every pass.
 * So the sum is staged. This table is rebuilt only for the hours a pass
 * touched, and reserves are then a sum over it — 24 rows a day per pool
 * instead of every swap ever. It stays an aggregation rather than a running
 * total, so it replays as cleanly as pool_fee_hourly does (§9).
 */
model PoolFlowHourly {
  poolId String   @map("pool_id")
  hour   DateTime
  delta0 Decimal  @db.Decimal(78, 0)
  delta1 Decimal  @db.Decimal(78, 0)

  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@id([poolId, hour])
  @@map("pool_flow_hourly")
}

/**
 * WETH in USD, per hour, from the one WETH/USDG anchor pool (§4.3).
 * Materialised for the same reason as the table above: every fee in every
 * pool is valued through this series, and recomputing it from the anchor's
 * whole swap history on each pass made the fee rebuild quadratic in the
 * number of hours indexed.
 * An hour with no anchor swap has no row. Readers carry the last price
 * forward rather than treating the gap as zero — a quiet hour in the anchor
 * pool is not WETH becoming worthless.
 */
model WethUsdHourly {
  hour    DateTime @id
  wethUsd Decimal  @map("weth_usd") @db.Decimal(38, 18)

  @@map("weth_usd_hourly")
}

/// Latest snapshot per pool. Overwritten, not appended.
model PoolState {
  poolId    String   @id @map("pool_id")
  tvlUsd    Decimal  @map("tvl_usd") @db.Decimal(38, 18)
  /// The quote side alone — the ether or USDG in the pool. `tvl_usd` values
  /// the token side at a price derived from the pool's own ratio, which for a
  /// pool holding most of a supply equals that token's FDV; this side is
  /// priced outside the pool, so it is what actually backs the price.
  /// Null until the rebuild has reached this pool: unknown, which the
  /// listing bar does not hold against it. Zero means it holds no quote.
  quoteTvlUsd Decimal? @map("quote_tvl_usd") @db.Decimal(38, 18)
  priceUsd  Decimal  @map("price_usd") @db.Decimal(38, 18)
  /// Fully diluted: total supply × price.
  mcUsd     Decimal  @map("mc_usd") @db.Decimal(38, 18)
  /// Market cap: circulating supply × price. Zero until the token's
  /// non-circulating holdings have been read.
  circMcUsd Decimal  @default(0) @map("circ_mc_usd") @db.Decimal(38, 18)
  /// sqrtPriceX96 at the last swap: the input to every derived price (§4.3).
  sqrtPrice Decimal  @map("sqrt_price_x96") @db.Decimal(78, 0)
  tick      Int
  liquidity Decimal  @db.Decimal(78, 0)
  updatedAt DateTime @map("updated_at")

  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@map("pool_state")
}

// ------------------------------------------------------------------ product --

model Vault {
  poolId         String   @id @map("pool_id")
  address        String   @unique
  totalStaked    Decimal  @map("total_staked") @db.Decimal(78, 0)
  totalStakedUsd Decimal  @map("total_staked_usd") @db.Decimal(38, 18)
  /// WETH per second out of the current 7-day window (§3.3).
  rewardRate     Decimal  @map("reward_rate") @db.Decimal(78, 0)
  periodFinish   DateTime @map("period_finish")
  stakers        Int
  protocolFeeBps Int      @map("protocol_fee_bps")
  updatedAt      DateTime @map("updated_at")

  pool   Pool    @relation(fields: [poolId], references: [id], onDelete: Cascade)
  stakes Stake[]

  @@map("vaults")
}

model Stake {
  wallet      String
  vaultId     String   @map("vault_id")
  shares      Decimal  @db.Decimal(78, 0)
  claimedWeth Decimal  @map("claimed_weth") @db.Decimal(78, 0)
  updatedAt   DateTime @map("updated_at")

  vault Vault @relation(fields: [vaultId], references: [poolId], onDelete: Cascade)

  @@id([wallet, vaultId])
  @@index([wallet])
  @@map("stakes")
}

/// One row per PositionManager token, rebuilt from position_transfers and
/// the salted liquidity events: current holder, pool, range, liquidity.
model Position {
  tokenId   String   @id @map("token_id")
  wallet    String
  poolId    String   @map("pool_id")
  tickLower Int      @map("tick_lower")
  tickUpper Int      @map("tick_upper")
  liquidity Decimal  @db.Decimal(78, 0)
  /// spot / curve / bidask — the frontend weight generator used at mint (§3.2).
  shape     String?
  /// `open`, or `burned` once the token has been sent to the zero address.
  status    String
  /// Net principal put in, in each token's smallest units: mints add, burns
  /// subtract. Valued at today's prices this is "what holding would be
  /// worth", the honest basis for price impact on holdings (§7).
  deposited0  Decimal   @default(0) @db.Decimal(78, 0)
  deposited1  Decimal   @default(0) @db.Decimal(78, 0)
  mintedBlock BigInt?   @map("minted_block")
  mintedAt    DateTime? @map("minted_at")
  updatedAt   DateTime  @map("updated_at")

  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@index([wallet])
  @@index([status])
  @@map("positions")
}

model RouterConfig {
  id             String   @id
  token          String
  feeSource      String   @map("fee_source")
  /// CADENCE or MILESTONE (§3.4).
  mode           String
  cadenceS       Int?     @map("cadence_s")
  milestonesJson Json?    @map("milestones_json")
  paused         Boolean  @default(false)
  updatedAt      DateTime @map("updated_at")

  routes RouterRoute[]

  @@index([token])
  @@map("router_configs")
}

model RouterRoute {
  id             String   @id @default(uuid())
  configId       String   @map("config_id")
  txHash         String   @unique @map("tx_hash")
  wethIn         Decimal  @map("weth_in") @db.Decimal(78, 0)
  liquidityAdded Decimal  @map("liquidity_added") @db.Decimal(78, 0)
  /// The 30-minute TWAP it routed at, never spot (§3.4).
  twapPrice      Decimal  @map("twap_price") @db.Decimal(38, 18)
  routedAt       DateTime @map("routed_at")

  config RouterConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId, routedAt])
  @@map("router_routes")
}
